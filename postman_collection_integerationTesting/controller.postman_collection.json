            "objects"
          ]
        },
        "description": "Every stored object (ObjectInfo), oldest first. [] when empty."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
