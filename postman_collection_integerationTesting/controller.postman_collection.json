    {
      "name": "Cluster (internal API)",
      "item": [
        {
          "name": "List workers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/workers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "workers"
              ]
            },
            "description": "Registered workers with status (AVAILABLE until the chunk list is loaded, then READY), chunk_count and last_seen. Saves the first worker_id into {{workerId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const ws = pm.response.json();",
                  "if (ws.length > 0) { pm.collectionVariables.set('workerId', ws[0].worker_id); }",
                  "pm.test('every worker READY', () => ws.forEach(w => pm.expect(w.status).to.eql('READY')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Object replicas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/objects/{{objectId}}/replicas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "objects",
                "{{objectId}}",
                "replicas"
              ]
            },
            "description": "Where each copy of every chunk of {{objectId}} lives: chunk_id, sequence_no, worker_id, worker_addr, status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('2 copies per chunk on different workers', () => {",
                  "  const by = {};",
                  "  b.replicas.forEach(r => (by[r.sequence_no] = by[r.sequence_no] || []).push(r.worker_id));",
                  "  pm.expect(Object.keys(by).length).to.eql(b.chunk_count);",
                  "  Object.values(by).forEach(ws => { pm.expect(ws.length).to.eql(2); pm.expect(ws[0]).to.not.eql(ws[1]); });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a worker (as a worker would)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/internal/workers/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "workers",
                "register"
              ]
            },
            "description": "Workers call this themselves at startup and every 30 s. Sent from Postman, the controller records your machine as a worker at <your IP>:<port> and will fail to load its chunk list, so it stays AVAILABLE. Mainly useful to see the request format.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"worker_id\": \"\",\n  \"port\": 8080\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deregister worker",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/workers/{{workerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "workers",
                "{{workerId}}"
              ]
            },
            "description": "Voluntary resignation of {{workerId}} (run List workers first). The controller forgets the worker and its copies; the worker gets 410 on its next announcement and stops announcing. Its copies are no longer used, so objects may be left with one copy."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Inspect a worker directly",
      "description": "Workers publish port 8080 on host ports 8081-8099. Find one with `docker compose port --index 1 worker 8080` and set the folder variable workerUrl to it.",
      "variable": [
        {
          "key": "workerUrl",
          "value": "http://localhost:8081"
        }
      ],
      "item": [
        {
          "name": "Worker: list chunk metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{workerUrl}}/internals/chunks/metadata",
              "host": [
                "{{workerUrl}}"
              ],
              "path": [
                "internals",
                "chunks",
                "metadata"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Worker: health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{workerUrl}}/healthz",
              "host": [
                "{{workerUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Pings the worker's SQLite database; 503 if it fails. Shows the controller-assigned worker_id."
          },
          "response": []
        }
      ]
    },
