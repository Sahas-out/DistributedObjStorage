        {
          "name": "Upload with fewer than 2 workers -> 503",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/objects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "objects"
              ]
            },
            "description": "Nothing detects stopped workers yet, so stopping or scaling down doesn't remove them from the controller. To get below 2 READY workers, restart the controller with one worker running: docker compose up -d --scale worker=1 && docker compose restart controller (wait ~30 s for the worker to re-announce). Afterwards: docker compose up -d --scale worker=4.",
            "body": {
              "mode": "raw",
