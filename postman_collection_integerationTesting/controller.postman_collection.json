          ],
          "path": [
            "api",
            "v1",
            "objects"
          ]
        },
        "description": "In the Body tab, choose 'binary' and select a file. Example: a 2.5 MiB file is stored as 3 chunks.",
        "body": {
          "mode": "file",
          "file": {
            "src": ""
