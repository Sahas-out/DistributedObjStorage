{
  "info": {
    "name": "DOS Controller API (with worker)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Client-facing controller API. Saved example responses were captured from a real controller + worker1 docker compose stack. Run 'Upload text object' first so {{objectId}} is set."
  },
