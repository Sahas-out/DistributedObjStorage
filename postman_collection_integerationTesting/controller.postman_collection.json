    {
      "name": "Upload text object",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/objects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "objects"
          ]
        },
        "description": "The body is the raw object bytes (not JSON). The controller splits it into 1 MiB chunks and stores them on the worker. The test script saves object_id into the {{objectId}} collection variable for the download requests.",
        "body": {
          "mode": "raw",
          "raw": "Hello, distributed world!",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        }
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/objects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "objects"
              ]
            },
            "description": "The body is the raw object bytes (not JSON). The controller splits it into 1 MiB chunks and stores them on the worker. The test script saves object_id into the {{objectId}} collection variable for the download requests.",
            "body": {
              "mode": "raw",
              "raw": "Hello, distributed world!",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "ETag",
              "value": "\"cf1fd83d5f47cc6004b1cf74c6b1fefa09048c2f2581bb577cea6e5538f38c9b\""
            },
            {
              "key": "Location",
              "value": "/api/v1/objects/4537785f9fe84ec13ac9d350daf00de8"
            }
          ],
          "body": "{\n  \"object_id\": \"4537785f9fe84ec13ac9d350daf00de8\",\n  \"size\": 25,\n  \"checksum\": \"cf1fd83d5f47cc6004b1cf74c6b1fefa09048c2f2581bb577cea6e5538f38c9b\",\n  \"chunk_count\": 1,\n  \"created_at\": \"2026-11-20T17:01:25.250874684Z\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('objectId', pm.response.json().object_id);",
              "  console.log('saved objectId =', pm.response.json().object_id);",
              "}",
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
